###############################################################################
# 1. GITHUB LINGUIST OVERRIDES (Fixing the Language Icon)
###############################################################################

# Force Razor components and C# files to count heavily toward C#
*.razor linguist-language=C#
*.cs linguist-language=C#

# Ignore bulky third-party static assets and CSS isolation bundles
wwwroot/lib/** linguist-vendored
wwwroot/css/** linguist-vendored
wwwroot/js/** linguist-vendored

# Ignore standard static boilerplate files that lean into HTML/JS stats
wwwroot/index.html linguist-vendored
wwwroot/appsettings.json linguist-documentation

# Ignore build, publish, and dependency injection outputs
obj/** linguist-generated
bin/** linguist-generated

###############################################################################
# 2. STANDARD DOTNET LINE ENDING & LFS RULES (Recommended Best Practice)
###############################################################################

# Auto-detect text files and normalize line endings to LF in git, CRLF on Windows
* text=auto

# Explicitly ensure source files use proper line endings
*.cs text eol=crlf
*.razor text eol=crlf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Treat binaries explicitly as data so Git doesn't try to refactor text inside them
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.dll binary
*.exe binary