@if (Server != null)
{

    <div data-name="@Server.Name"
            data-status="Server is @OnlineOrOffline"
            style="@($"color: {(Server.IsOnline ? "green" : "red")}")">
        @Server.Name is in @Server.City that is @OnlineOrOffline
        &nbsp;
        <button type="submit" class="btn btn-primary" @onclick="ToggleStatus">
            Toggle Status
        </button>
    </div>

}

@code {

    private Server? Server { get; set; } = new Server { Name = "Server 1", City = "Toronto" };
    private string OnlineOrOffline => Server.IsOnline ? "online" : "offline";

    private void ToggleStatus()
    {
        if (Server != null)
        {
            Server.IsOnline = !Server.IsOnline;
        }
    }

}
