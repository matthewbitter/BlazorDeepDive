@inject NavigationManager NavigationManager

@if (Server != null)
{

    <tr @key="Server.ServerId" style="background-color: @GetBackgroundColor()">
        <td>
            <a href="/Servers/@Server.ServerId" class="btn btn-link">
                @Server.Name
            </a>
        </td>
        <td>
            @Server.City
        </td>
        <td style="color: @(Server.IsOnline ? "green" : "red")">
            @(Server.IsOnline ? "Online" : "Offline")
        </td>
        <td>
            @if (Server.IsOnline)
            {
                var random = new Random();
                var randomNumber = random.Next(0, 500);
                <text>@randomNumber People Online</text>
            }
            else
            {
                <text>N/A</text>
            }
        </td>
        <td>
            @if (Server.IsOnline)
            {
                <button type="button" class="btn btn-outline-danger" @onclick="@(() => { Server.IsOnline = false; })">
                    Turn Off
                </button>
            }
            else
            {
                <button type="button" class="btn btn-outline-success" @onclick="@(() => { Server.IsOnline = true; })">
                    Turn On
                </button>
            }
        </td>
        <td>
            <EditForm Model="Server" FormName="@($"FormServer-{Server.ServerId}")" OnValidSubmit="() => { DeleteServer(Server.ServerId); }" style="@($"background-color: {GetBackgroundColor()}")">
                <button type="submit" class="btn btn-secondary">
                    Delete
                </button>
            </EditForm>
        </td>
    </tr>

}

@code {

    [Parameter]
    public Server? Server { get; set; }

    [CascadingParameter(Name = "SelectedCity")]
    public string? SelectedCity { get; set; }

    protected override void OnParametersSet()
    {

        if (Server != null)
        {
            Server = new Server
            {
                ServerId = Server.ServerId,
                Name = Server.Name,
                City = Server.City,
                IsOnline = Server.IsOnline
            };
        }

    }

    private void DeleteServer(int serverId)
    {

        ServersRepository.DeleteServer(serverId);

        NavigationManager.NavigateTo("/servers", true);

    }


    private string GetBackgroundColor()
    {

        if (SelectedCity != null)
        {
            return "lightblue";
        }

        return "white";

    }

}
