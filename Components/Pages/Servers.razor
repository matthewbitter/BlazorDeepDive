@page "/servers"

@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<h3>Servers</h3>

<br />
<br />

<CityListComponent @rendermode="InteractiveServer" OnCitySelected="SelectCity" />

<ServerSearchComponent @rendermode="InteractiveServer" ServerFilter="@ServerFilter" OnServerFilterChanged="OnServerFilterChanged" />

<ServerListComponent @rendermode="InteractiveServer" SelectedCity="@selectedCity" ServerFilter="@ServerFilter" />

@code {

    private string selectedCity = "Toronto";

    private string ServerFilter = "";

    private void SelectCity(string city)
    {
        selectedCity = city;
    }

    private void OnServerFilterChanged(string serverFilter)
    {
        ServerFilter = serverFilter;
    }
    

}
