@if (Servers != null && Servers.Count > 0)
{

    <br />
    <a href="/Servers/Add" class="btn btn-primary">
        Add Server
    </a>
    <br />
}

<table class="table table-striped">
    <RepeaterComponent TItem="Server" Items="Servers">
        <Header>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>City</th>
                    <th>Status</th>
                    <th>People Online</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
        </Header>
        <Row Context="server">
            <ServerComponent Server="server" />
        </Row>
    </RepeaterComponent>
</table>

@code {

    [Parameter]
    public string? SelectedCity { get; set; }
    [Parameter]
    public string? ServerFilter { get; set; }

    private List<Server>? Servers;

    protected override void OnParametersSet()
    {
        // Ensure a non-null list to avoid null dereference and to satisfy Virtualize
        Servers = ServersRepository.GetServersByCity(SelectedCity ?? "Toronto") ?? new List<Server>();

        if (!string.IsNullOrEmpty(ServerFilter))
        {
            Servers = Servers.Where(s => s.Name!.Contains(ServerFilter, StringComparison.OrdinalIgnoreCase)).ToList();
        }

    }

}
