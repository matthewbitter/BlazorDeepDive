@page "/servers"

@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<h3>Servers</h3>

<br />
<br />

@SelectedCity
@ServerFilter

<CityListComponent @ref="CityListComponent" @rendermode="InteractiveServer" OnCitySelected="SelectCity" />

<ServerSearchComponent @ref="ServerSearchComponent" @rendermode="InteractiveServer" ServerFilter="@ServerFilter" OnServerFilterChanged="OnServerFilterChanged" />

<CascadingValue Name="SelectedCity" Value="@SelectedCity">
    <ServerListComponent @rendermode="InteractiveServer" SelectedCity="@SelectedCity" ServerFilter="@ServerFilter" />
</CascadingValue>

@code {

    private string SelectedCity = "Toronto";
    private string ServerFilter = "";
    private CityListComponent? CityListComponent;
    private ServerSearchComponent? ServerSearchComponent;

    private void SelectCity(string city)
    {
        SelectedCity = city;
        ServerFilter = "";
        ServerSearchComponent?.ClearFilter();
    }

    private void OnServerFilterChanged(string serverFilter)
    {
        ServerFilter = serverFilter;
        SelectedCity = "";
        CityListComponent?.ClearSelectedCity();
    }
    

}
