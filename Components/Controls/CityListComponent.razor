<h4>Selected City: @SelectedCity</h4>

<div class="container-fluid text-center">
    <div class="row w-50">
        @foreach (var city in cities)
        {
            <CityComponent City="@city" SelectedCity="@SelectedCity" OnCitySelected="SelectCity" />
        }
    </div>
</div>

@code {

    private List<String> cities = CitiesRepository.GetCities().ToList<String>();
    private string SelectedCity = "Toronto";

    [Parameter]
    public EventCallback<string> OnCitySelected { get; set; }

    private void SelectCity(string city)
    {
        SelectedCity = city;
        OnCitySelected.InvokeAsync(city);
    }

    public void ClearSelectedCity()
    {
        SelectedCity = "";
        StateHasChanged();
    }

}
